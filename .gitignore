# ============================================================
#  Unity .gitignore
#  Strategy: Track code + scene/prefab/asset data only.
#  Heavy binary assets (textures, audio, meshes, videos) are
#  excluded so that code-only workstations (Cursor / Antigravity)
#  stay lean. Unity on the primary PC handles those files locally.
#
#  Source: https://github.com/github/gitignore/blob/main/Unity.gitignore
# ============================================================


# ── sync.sh logs ────────────────────────────────────────────
.sync_logs/

# ── Unity generated directories ─────────────────────────────
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
.utmp/
.utmp.meta
# Diagnostics
sysinfo.txt
build_timestamp.txt
NinjaStrike.x86_64

# ── OS / IDE noise ───────────────────────────────────────────
.vs/
.gradle/
.consulo/
.DS_Store
Thumbs.db
*.log

# ── Autogenerated solution / project files ───────────────────
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ── Unity3D generated meta files for the above ───────────────
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ── Rider / JetBrains ────────────────────────────────────────
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# ── Crash / diagnostics ──────────────────────────────────────
sysinfo.txt
mono_crash.*

# ── Build outputs ────────────────────────────────────────────
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# ── Misc Unity internals ─────────────────────────────────────
/[Mm]emoryCaptures/
/[Rr]ecordings/
crashlytics-build.properties
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ── Addressables ─────────────────────────────────────────────
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ── Visual Scripting ─────────────────────────────────────────
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ── Blender swap files ───────────────────────────────────────
*.blend1
*.blend1.meta


# ============================================================
#  CODE-ONLY WORKSTATION — heavy binary assets
#  These files are managed on the primary Unity PC only.
#  Code editors (Cursor / Antigravity) don't need them.
# ============================================================

# Textures & images
*.psd
*.psd.meta
*.tga
*.tga.meta
*.tif
*.tif.meta
*.tiff
*.tiff.meta
*.bmp
*.bmp.meta
*.exr
*.exr.meta
*.hdr
*.hdr.meta
# PNG / JPG kept small exceptions can be un-ignored per folder:
#   e.g. !Assets/UI/Icons/*.png
*.png
*.png.meta
*.jpg
*.jpg.meta
*.jpeg
*.jpeg.meta
*.gif
*.gif.meta
*.svg
*.svg.meta
*.webp
*.webp.meta

# 3D models & meshes
*.fbx
*.fbx.meta
*.obj
*.obj.meta
*.dae
*.dae.meta
*.3ds
*.3ds.meta
*.blend
*.blend.meta
*.max
*.max.meta
*.ma
*.ma.meta
*.mb
*.mb.meta
*.ply
*.ply.meta
*.stl
*.stl.meta

# Audio
*.wav
*.wav.meta
*.mp3
*.mp3.meta
*.ogg
*.ogg.meta
*.aiff
*.aiff.meta
*.aif
*.aif.meta
*.flac
*.flac.meta
*.m4a
*.m4a.meta
*.wma
*.wma.meta

# Video
*.mp4
*.mp4.meta
*.mov
*.mov.meta
*.avi
*.avi.meta
*.webm
*.webm.meta
*.mkv
*.mkv.meta

# Fonts (binary)
*.ttf
*.ttf.meta
*.otf
*.otf.meta
*.woff
*.woff.meta
*.woff2
*.woff2.meta

# Shader pre-compiled caches (can be large)
ShaderCache/
*.shadervariants
*.shadervariants.meta

# Physics / animation baked data
*.physicMaterial
*.physicMaterial.meta
*.physicsMaterial2D
*.physicsMaterial2D.meta

# Large terrain / lightmap data baked by Unity
**/[Ll]ightingData.asset
**/[Ll]ightingData.asset.meta
**/[Ll]ightmaps-*/
**/[Ll]ightmaps-*.meta


# ============================================================
#  ALWAYS TRACKED (do NOT add these above)
#  These are the files that make sense to edit remotely:
#    Assets/**/*.cs          — C# source code
#    Assets/**/*.hlsl        — Shader code
#    Assets/**/*.glsl        — Shader code
#    Assets/**/*.shader      — Unity ShaderLab
#    Assets/**/*.compute     — Compute shaders
#    Assets/**/*.unity       — Scenes
#    Assets/**/*.prefab      — Prefabs
#    Assets/**/*.asset       — ScriptableObjects / settings
#    Assets/**/*.anim        — Animation clips
#    Assets/**/*.controller  — Animator controllers
#    Assets/**/*.mask        — Avatar masks
#    Assets/**/*.inputactions — Input System
#    Assets/**/*.json        — Data / configs
#    Assets/**/*.xml         — Data / configs
#    Assets/**/*.yaml / .yml — Data / configs
#    Assets/**/*.txt         — Text files
#    Assets/**/*.md          — Documentation
#    Packages/               — Package manifest
#    ProjectSettings/        — Project config
# ============================================================
